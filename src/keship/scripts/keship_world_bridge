#!/usr/bin/env python3
"""Keship 世界桥接节点 — 动态管理每个模型的 ROS 2 bridge"""

import json
import os
import signal
import subprocess
import rclpy
from rclpy.node import Node
from std_msgs.msg import String


class KeshipWorldBridge(Node):
    """监听 /keship/model_ready，动态创建/销毁 per-model ros_gz_bridge 子进程"""

    def __init__(self):
        super().__init__('keship_world_bridge')
        self.sub_ = self.create_subscription(
            String, '/keship/model_ready', self.on_model_ready, 10)
        self.bridges_ = {}
        # ★ 2026-10-02：YAML 中间产物目录（代码生成、随模型生命周期创建/删除，
        #   不是需要人工维护的配置文件）
        self.bridge_dir_ = '/tmp/keship_bridges'
        self.get_logger().info('KeshipWorldBridge 就绪，等待模型事件...')

    def on_model_ready(self, msg: String):
        try:
            data = json.loads(msg.data)
        except json.JSONDecodeError:
            self.get_logger().error(f'无效 JSON: {msg.data}')
            return
        event = data.get('event', '')
        name = data.get('name', '')
        if not name:
            return
        if event == 'spawn':
            self._spawn_bridge(name, data.get('thrusters', []), data.get('sensors', {}))
        elif event == 'delete':
            self._delete_bridge(name)

    # 传感器类型 → (data_type, ros_msg, gz_msg) 映射表
    SENSOR_MAP = {
        'IMU':          ('imu',          'sensor_msgs/msg/Imu',            'gz.msgs.IMU'),
        'NavSat':       ('navsat',       'sensor_msgs/msg/NavSatFix',      'gz.msgs.NavSat'),
        'Magnetometer': ('magnetometer', 'sensor_msgs/msg/MagneticField',  'gz.msgs.Magnetometer'),
        'Camera':       ('image',        'sensor_msgs/msg/Image',          'gz.msgs.Image'),
        'Lidar':        ('scan',         'sensor_msgs/msg/LaserScan',      'gz.msgs.LaserScan'),
    }

    # ★ 2026-10-02：**渲染型**传感器（会拉起渲染管线）→ 桥接采用 lazy。
    #   依据：零订阅 ⇒ 传感器不启动 ⇒ 不渲染 ⇒ 不泄漏（实测）；
    #        取消订阅 ⇒ 立即停止增长（实测）；而 d3d12 后端在渲染时持续泄漏。
    #   非渲染型（IMU/NavSat/Magnetometer）保持持续桥接，行为不变。
    RENDER_SENSOR_TYPES = {'Camera', 'Lidar'}

    def _bridge_yaml_path(self, model_name: str) -> str:
        return os.path.join(self.bridge_dir_, f'{model_name}.yaml')

    @staticmethod
    def _yaml_entry(ros_topic: str, gz_topic: str, ros_type: str,
                    gz_type: str, direction: str, lazy: bool = False) -> str:
        """生成单条 bridge 的 YAML 片段（字符串拼接，不依赖 PyYAML）。"""
        lines = [
            f'- ros_topic_name: "{ros_topic}"',
            f'  gz_topic_name: "{gz_topic}"',
            f'  ros_type_name: "{ros_type}"',
            f'  gz_type_name: "{gz_type}"',
            f'  direction: {direction}',
        ]
        if lazy:
            lines.append('  lazy: true')
        return '\n'.join(lines)

    def _spawn_bridge(self, model_name: str, thrusters: list, sensors: list):
        """sensors 是实例列表: [{"type":"Camera","name":"front_cam","link":"base_link"}, ...]

        ★ 2026-10-02 改动：由「CLI 参数 + -r remap」改为「生成 YAML + config_file」。
          原因：`lazy` 只能通过 YAML 配置项设置（CLI 与 -p lazy:=true 均实测无效）。
          YAML 里两端话题名各自显式给出，因此**不再需要 -r remap**，
          且**ROS 话题名与改前逐字一致**（GUI 相机查看器按此名订阅）。
        """
        if model_name in self.bridges_:
            self._delete_bridge(model_name)

        entries = []

        # 位姿（非渲染，持续桥接）
        entries.append(self._yaml_entry(
            f'{model_name}/pose',
            '/world/keship_world/pose/info',
            'geometry_msgs/msg/PoseStamped', 'gz.msgs.Pose', 'GZ_TO_ROS'))

        # 推进器（ROS → GZ，持续）
        for t in thrusters:
            topic = f'/keship/thrust/{model_name}/{t}'
            entries.append(self._yaml_entry(
                topic, topic, 'std_msgs/msg/Float64', 'gz.msgs.Double', 'ROS_TO_GZ'))

        # 传感器（GZ → ROS）；渲染型走 lazy
        sensor_count = 0
        lazy_count = 0
        for s in sensors:
            s_type = s.get('type', '')
            s_name = s.get('name', '')
            s_link = s.get('link', 'base_link')
            info = self.SENSOR_MAP.get(s_type)
            if not info or not s_name:
                continue
            data_type, ros_msg, gz_msg = info
            gz_topic = (f'/world/keship_world/model/{model_name}'
                        f'/link/{s_link}/sensor/{s_name}/{data_type}')
            ros_topic = f'{model_name}/{s_type.lower()}/{s_name}'
            is_lazy = s_type in self.RENDER_SENSOR_TYPES
            entries.append(self._yaml_entry(
                ros_topic, gz_topic, ros_msg, gz_msg, 'GZ_TO_ROS', lazy=is_lazy))
            sensor_count += 1
            if is_lazy:
                lazy_count += 1

        os.makedirs(self.bridge_dir_, exist_ok=True)
        yaml_path = self._bridge_yaml_path(model_name)
        with open(yaml_path, 'w', encoding='utf-8') as f:
            f.write('\n'.join(entries) + '\n')

        args = [
            'ros2', 'run', 'ros_gz_bridge', 'parameter_bridge',
            '--ros-args',
            '-r', f'__node:={model_name}_bridge',
            '-p', f'config_file:={os.path.abspath(yaml_path)}',
        ]

        self.get_logger().info(
            f'[{model_name}] 启动 bridge: {len(thrusters)} 个推进器, '
            f'{sensor_count} 个传感器（其中 {lazy_count} 个 lazy 渲染型）'
            f' | YAML={yaml_path}')
        proc = subprocess.Popen(args, start_new_session=True,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.bridges_[model_name] = proc

    def _delete_bridge(self, model_name: str):
        proc = self.bridges_.pop(model_name, None)
        if proc:
            self.get_logger().info(f'[{model_name}] 停止 bridge')
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
            except ProcessLookupError:
                pass
            else:
                try:
                    proc.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        # 清理 YAML 中间产物
        try:
            os.remove(self._bridge_yaml_path(model_name))
        except OSError:
            pass

    def destroy_node(self):
        for name in list(self.bridges_.keys()):
            self._delete_bridge(name)
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = KeshipWorldBridge()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.destroy_node()


if __name__ == '__main__':
    main()
