<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelayout="1.0"?>
<package format="3">
  <name>keship</name>
  <version>0.1.0</version>
  <description>Keship marine robotics simulation package</description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- ROS 2依赖 -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  
  <!-- Gazebo依赖 -->
  <depend>gz-sim8</depend>
  <depend>gz-common5</depend>
  <depend>eigen3</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- GUI Plugin dependencies -->
  <build_depend>gz-gui8</build_depend>
  <build_depend>Qt5Core</build_depend>
  <build_depend>Qt5Quick</build_depend>
  <build_depend>Qt5QuickControls2</build_depend>

  <exec_depend>gz-gui8</exec_depend>
  <exec_depend>Qt5Core</exec_depend>
  <exec_depend>Qt5Quick</exec_depend>
  <exec_depend>Qt5QuickControls2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <ament_python>src_py</ament_python>
    <gz_gui_plugin path="lib/libMenuPluginKeship.so">MenuPluginKeship</gz_gui_plugin>
  </export>


  
</package>