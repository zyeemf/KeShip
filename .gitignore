# ===== 大模型二进制：目录结构保留（.gitkeep），文件不入库 =====
# 注意：忽略"目录内容"而非"目录本身"；子目录须先 !复活目录、再忽略其内容、再 !复活 .gitkeep
models_all/robot_model/*
!models_all/robot_model/keship3/
!models_all/robot_model/wamv/
!models_all/robot_model/yanhu/
models_all/robot_model/keship3/*
!models_all/robot_model/keship3/.gitkeep
models_all/robot_model/wamv/*
!models_all/robot_model/wamv/.gitkeep
models_all/robot_model/yanhu/*
!models_all/robot_model/yanhu/.gitkeep
data/models_normalized/*
!data/models_normalized/.gitkeep
data/experiments/*
!data/experiments/disp/
!data/experiments/probe_compare/
!data/experiments/sp03/
data/experiments/disp/*
!data/experiments/disp/.gitkeep
data/experiments/probe_compare/*
!data/experiments/probe_compare/.gitkeep
data/experiments/sp03/*
!data/experiments/sp03/.gitkeep

