# GUI 测试台配置（阶段 1）
# 坐标是**窗口相对坐标**（xdotool --window），窗口挪位置不影响。
# 首次运行只会跑到 01_start.png；据此标定坐标后，再跑就会走 T6/T7。

SCREEN_W=1600
SCREEN_H=1000
START_TIMEOUT=180
CLICK_WAIT=1.2
WINDOW_TITLE="keship - Gazebo Simulator"

# ── 坐标（首次运行后标定；留空则跳过点击用例）──
# 「加载 ▾」按钮中心
LOAD_BTN_X=53
LOAD_BTN_Y=108
# 「生成数学船型」菜单项中心
MATHHULL_X=150
MATHHULL_Y=220
