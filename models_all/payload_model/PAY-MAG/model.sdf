<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-MAG">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-MAG/meshes/PAY-MAG.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.0 0.0 0.0155 0 0 0</pose>
        <geometry>
          <box>
            <size>0.052 0.042 0.031</size>
          </box>
        </geometry>
      </collision>
      <sensor name="magnetometer" type="magnetometer">
        <pose>0 0 0.020 0 0 0</pose>
        <always_on>true</always_on>
        <topic>mag/data</topic>
      </sensor>
    </link>
  </model>
</sdf>
