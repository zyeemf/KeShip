<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-CAM">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-CAM/meshes/PAY-CAM.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="camera" type="camera">
        <pose>0.095 0 0.095 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>camera/image</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
