<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-CAM">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-CAM/meshes/PAY-CAM.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.018 0.0 0.066 0 0 0</pose>
        <geometry>
          <box>
            <size>0.166 0.13 0.132</size>
          </box>
        </geometry>
      </collision>
      <sensor name="camera" type="camera">
        <pose>0.095 0 0.095 0 0 0</pose>
        <always_on>true</always_on>
        <topic>camera/image</topic>
      </sensor>
    </link>
  </model>
</sdf>
