<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-IMU">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-IMU/meshes/PAY-IMU.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>-0.0075 0.0 0.0235 0 0 0</pose>
        <geometry>
          <box>
            <size>0.115 0.08 0.047</size>
          </box>
        </geometry>
      </collision>
      <sensor name="imu" type="imu">
        <pose>0 0 0.0295 0 0 0</pose>
        <always_on>true</always_on>
        <topic>imu/data</topic>
      </sensor>
    </link>
  </model>
</sdf>
