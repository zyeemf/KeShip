<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-GNSS">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-GNSS/meshes/PAY-GNSS.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.0 0.0 0.0626 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 0.15 0.1253</size>
          </box>
        </geometry>
      </collision>
      <sensor name="gnss" type="navsat">
        <pose>0 0 0.1253 0 0 0</pose>
        <always_on>true</always_on>
        <topic>gnss/fix</topic>
      </sensor>
    </link>
  </model>
</sdf>
