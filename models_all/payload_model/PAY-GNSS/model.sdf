<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-GNSS">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-GNSS/meshes/PAY-GNSS.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="gnss" type="navsat">
        <pose>0 0 0.1253 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>gnss/fix</topic>
        <navsat>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.5</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>1.0</stddev>
              </noise>
            </vertical>
          </position_sensing>
        </navsat>
      </sensor>
    </link>
  </model>
</sdf>
