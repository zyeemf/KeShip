<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-LIDAR">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-LIDAR/meshes/PAY-LIDAR.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0.0 0.0 0.0601 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.12 0.1201</size>
          </box>
        </geometry>
      </collision>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.075 0 0 0</pose>
        <always_on>true</always_on>
        <topic>lidar/scan</topic>
      </sensor>
    </link>
  </model>
</sdf>
