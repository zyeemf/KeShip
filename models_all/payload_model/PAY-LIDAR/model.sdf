<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-LIDAR">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-LIDAR/meshes/PAY-LIDAR.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.075 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>lidar/scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
  </model>
</sdf>
