<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PAY-WIND">
    <static>true</static>
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://PAY-WIND/meshes/PAY-WIND.glb</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <!-- No built-in SDF wind sensor; expose the rotor center as a model-scope
         frame so a custom plugin / sensor can attach here. -->
    <frame name="anemometer">
      <pose>0 0 0.301 0 0 0</pose>
    </frame>
  </model>
</sdf>
