     gz::sim::Entity activeWfEntity_{gz::sim::kNullEntity};
+
+    /// \brief 该 link 是否有**非零**流体附加质量（Configure 时判定一次）。
+    /// 为 false 时"出水取消 M_A"整段不生效 ⇒ 其他模型完全不受影响。
+    bool hasAddedMass_ = false;
